<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== 顶部标题栏 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_logo"
                android:contentDescription="@string/app_name"
                android:padding="5dp"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="日志"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_unbind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="解绑"
                android:textColor="@color/brand_red"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ==================== 三个页签 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动关注"
                    android:textColor="@color/brand_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indicator_auto"
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_nurture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="养号助手"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/indicator_nurture"
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="直播互动"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/indicator_live"
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- ==================== 内容区 ==================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/content_auto"
                layout="@layout/content_auto_follow" />

            <include
                android:id="@+id/content_nurture"
                layout="@layout/content_nurture"
                android:visibility="gone" />

            <include
                android:id="@+id/content_live"
                layout="@layout/content_live"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ==================== 底部操作条 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/btn_start_service"
                style="@style/BtnPrimary"
                android:text="开始服务" />

            <TextView
                android:id="@+id/btn_open_douyin"
                style="@style/BtnOutline"
                android:layout_marginStart="10dp"
                android:text="打开抖音" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 悬浮菜单按钮 ==================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="74dp"
        android:contentDescription="菜单"
        android:src="@drawable/ic_menu"
        app:backgroundTint="@color/brand_red"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        app:rippleColor="#66FFFFFF"
        app:tint="@color/white" />

</FrameLayout>
