<?xml version="1.0" encoding="utf-8"?>
<!--
  自动关注 · 参数区（vc49 起为「一页放下」布局）

  设计约束（真机 360×791dp，可视内容区 589dp）：
  - 三个核心参数（目标 / 每日上限 / 扫描间隔）压成**一行三列**，每列 96dp；
    「目标关注数量」「每日关注上限」6 字 12sp = 72dp，「10000」14sp ≈ 64dp，都放得下。
  - 不再有「校准模式」「延迟抖动」：前者是死参数，后者改为固定 ±30% 内建。
  - 定时休息压成内联一行，用 InputMini（52×32）。
  - 三个开关目前**未接入任何流程**（引擎里零引用），置灰 + 标「暂未生效」，
    以后接流程只需把 isEnabled 改 true 并删掉注记。
  - 授权信息卡整卡删除，入口在顶栏 tv_license_badge（含到期日期）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <com.doujiajia.app.ui.PermissionCardView
            android:id="@+id/perm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <!-- ==================== 参数设置 ==================== -->
        <LinearLayout
            style="@style/CardBox">

            <TextView
                style="@style/TxtSection"
                android:text="参数设置" />

            <!-- 三列核心参数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TxtFieldLabel"
                        android:maxLines="1"
                        android:text="目标关注数量" />

                    <EditText
                        android:id="@+id/et_follow_target"
                        style="@style/InputBox"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="200" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TxtFieldLabel"
                        android:maxLines="1"
                        android:text="每日关注上限" />

                    <EditText
                        android:id="@+id/et_daily_limit"
                        style="@style/InputBox"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="200" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TxtFieldLabel"
                        android:maxLines="1"
                        android:text="扫描间隔" />

                    <EditText
                        android:id="@+id/et_scan_interval"
                        style="@style/InputBox"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="30" />

                    <!-- 单位：秒 / 分钟。数值上限随单位变（秒 ≤3600，分钟 ≤60） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/seg_interval_sec"
                            style="@style/SegMini"
                            android:text="秒" />

                        <TextView
                            android:id="@+id/seg_interval_min"
                            style="@style/SegMini"
                            android:layout_marginStart="6dp"
                            android:text="分钟" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 定时休息：标题行（说明这个开关管什么）+ 参数行 + 关闭提示。
                 原来只有「每关注 5 个后休息 30 秒」+ 最右一个裸开关，用户不知道开关管哪行，
                 关掉后两个框变灰又像"坏了不能设置"。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TxtFieldLabel"
                    android:text="定时休息" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_interval_rest"
                    style="@style/AppSwitch"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TxtFieldLabel"
                    android:text="每关注" />

                <EditText
                    android:id="@+id/et_rest_after_n"
                    style="@style/InputMini"
                    android:layout_marginStart="6dp"
                    android:text="5" />

                <TextView
                    style="@style/TxtFieldLabel"
                    android:layout_marginStart="6dp"
                    android:text="个后休息" />

                <EditText
                    android:id="@+id/et_rest_seconds"
                    style="@style/InputMini"
                    android:layout_marginStart="6dp"
                    android:text="30" />

                <TextView
                    style="@style/TxtFieldLabel"
                    android:layout_marginStart="6dp"
                    android:text="秒" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rest_off_hint"
                style="@style/TxtHint"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:text="已关闭：跑的过程中不会中途休息"
                android:visibility="gone" />

            <!-- 以下三项尚未接入流程：置灰 + 明示「暂未生效」 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TxtRowTitle"
                    android:text="空闲时直播互动"
                    android:textColor="@color/text_secondary" />

                <TextView
                    style="@style/TxtRowSub"
                    android:layout_marginStart="6dp"
                    android:text="暂未生效"
                    android:textColor="@color/text_tertiary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_idle_live"
                    style="@style/AppSwitch"
                    android:alpha="0.5"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TxtRowTitle"
                    android:text="自动申请连麦"
                    android:textColor="@color/text_secondary" />

                <TextView
                    style="@style/TxtRowSub"
                    android:layout_marginStart="6dp"
                    android:text="暂未生效"
                    android:textColor="@color/text_tertiary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_apply_mic"
                    style="@style/AppSwitch"
                    android:alpha="0.5"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TxtRowTitle"
                    android:text="下麦后继续干活"
                    android:textColor="@color/text_secondary" />

                <TextView
                    style="@style/TxtRowSub"
                    android:layout_marginStart="6dp"
                    android:text="暂未生效"
                    android:textColor="@color/text_tertiary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_continue_after_mic"
                    style="@style/AppSwitch"
                    android:alpha="0.5"
                    android:enabled="false" />
            </LinearLayout>

            <!-- 配置引导条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="评论参数请在「直播互动」页签配置"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_go_config"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="去配置 ›"
                    android:textColor="@color/warning_amber"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
