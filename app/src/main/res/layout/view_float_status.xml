<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗：收起态是一条窄胶囊，展开态是控制面板。

  为什么要展开态：任务跑起来之后用户的注意力在抖音上，回抖加加看进度等于把主播画面切走，
  再切回来还可能掉出直播间。所以「看进度、暂停、结束」全部就地完成，**不跳任何界面**。

  收起态刻意做得很窄（≤ 210dp），压在抖音界面上不能挡住关注按钮那种高频操作的区域；
  展开态由用户主动点开，挡住也没关系，点右上角箭头就能收回去。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/float_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_float_pill"
    android:orientation="vertical">

    <!-- ==================== 收起态：胶囊 ==================== -->
    <LinearLayout
        android:id="@+id/float_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/float_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_green" />

        <TextView
            android:id="@+id/float_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxWidth="132dp"
            android:singleLine="true"
            android:text="准备中"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- 展开：点这一小块，而不是点整条，避免「想拖动却展开了」 -->
        <TextView
            android:id="@+id/float_expand"
            android:layout_width="26dp"
            android:layout_height="22dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ==================== 展开态：控制面板 ==================== -->
    <LinearLayout
        android:id="@+id/float_panel"
        android:layout_width="208dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_float_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- 标题行：状态点 + 状态 + 收起箭头 -->
        <LinearLayout
            android:id="@+id/float_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/float_dot_panel"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:id="@+id/float_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="运行中"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/float_collapse"
                android:layout_width="26dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="⌃"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 大号计数：24/200 -->
        <TextView
            android:id="@+id/float_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0/0"
            android:textColor="@color/brand_red"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/float_counter_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已关注"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <!-- 一句话说明：正在做什么 / 为什么停了 -->
        <TextView
            android:id="@+id/float_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- 主操作：暂停/继续 + 结束 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/float_toggle"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_small"
                android:gravity="center"
                android:text="暂停"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/float_finish"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_danger_soft"
                android:gravity="center"
                android:text="结束"
                android:textColor="@color/brand_red"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider" />

        <!-- 统计行：本场涨粉 · 今日累计 · 已关人数（对标竞品「本场涨粉/今日累计/已关人数」） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/float_session"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本场 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/float_today"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="今日 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/float_known"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已关 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/float_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="重置"
                android:textColor="@color/brand_red"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 设置关注 / 已关人数（对标竞品同名按钮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/float_set_target"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="设置关注"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/float_show_names"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="已关人数"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 「设置关注」展开的输入行。
             悬浮窗默认 FLAG_NOT_FOCUSABLE，EditText 拿不到焦点也弹不出键盘；
             点开时由 FloatWindowService 临时把窗口切成可聚焦，收起时切回去。 -->
        <LinearLayout
            android:id="@+id/float_target_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/float_target_input"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="目标数量"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/float_target_ok"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_small"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="确定"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 「已关人数」展开的名单（最新关注在最前） -->
        <ScrollView
            android:id="@+id/float_names_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hint"
            android:maxHeight="150dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/float_names_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:padding="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </ScrollView>

        <!-- 收藏直播间 / 选择直播间（对标竞品同名按钮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/float_save_room"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="收藏直播间"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/float_pick_room"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="选择直播间"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 「选择直播间」展开的收藏列表；行由 FloatWindowService 动态生成，每行可点 -->
        <ScrollView
            android:id="@+id/float_rooms_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hint"
            android:maxHeight="150dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/float_rooms_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp" />
        </ScrollView>

        <TextView
            android:id="@+id/float_close"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="关闭悬浮窗"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
