<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮状态胶囊：状态点 + 一行摘要 + 停止键。
  刻意做得很窄（≤ 210dp），压在抖音界面上不能挡住关注按钮那种高频操作的区域；
  用户也可以拖动它，见 FloatWindowService 的触摸处理。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/float_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_float_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="5dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/float_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_green" />

    <TextView
        android:id="@+id/float_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxWidth="150dp"
        android:singleLine="true"
        android:text="准备中"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/float_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_small"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/notification_action_stop"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
