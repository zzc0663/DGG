<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <com.example.dgg.ui.PermissionCardView
            android:id="@+id/perm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <!-- ==================== 直播间进入方式 ==================== -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/TxtSection"
                android:text="直播间进入方式" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/seg_enter_manual"
                    style="@style/SegItemSelected"
                    android:text="手动进入" />

                <TextView
                    android:id="@+id/seg_enter_recommend"
                    style="@style/SegItem"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_normal"
                    android:text="系统推荐" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 互动设置 ==================== -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/TxtSection"
                android:text="互动设置" />

            <!-- 自动申请连麦 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TxtRowTitle"
                        android:text="自动申请连麦" />

                    <TextView
                        style="@style/TxtRowSub"
                        android:layout_marginTop="4dp"
                        android:text="开始互动后自动点击连线并申请" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_mic_request"
                    style="@style/AppSwitch" />
            </LinearLayout>

            <!-- 评论发送间隔 -->
            <TextView
                style="@style/TxtFieldLabel"
                android:layout_marginTop="18dp"
                android:text="评论发送间隔（随机范围，秒）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_comment_gap_min"
                    style="@style/InputBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="~"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_comment_gap_max"
                    style="@style/InputBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="15" />
            </LinearLayout>

            <!-- 评论时自动点赞 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TxtRowTitle"
                        android:text="评论时自动点赞" />

                    <TextView
                        style="@style/TxtRowSub"
                        android:layout_marginTop="4dp"
                        android:text="每发N条评论自动点赞" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_like_on_comment"
                    style="@style/AppSwitch"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                style="@style/TxtFieldLabel"
                android:layout_marginTop="14dp"
                android:text="每发几条评论触发点赞" />

            <EditText
                android:id="@+id/et_like_trigger"
                style="@style/InputBox"
                android:layout_marginTop="6dp"
                android:text="3" />

            <TextView
                style="@style/TxtFieldLabel"
                android:layout_marginTop="14dp"
                android:text="每次自动点赞次数（随机范围）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_like_count_min"
                    style="@style/InputBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="~"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_like_count_max"
                    style="@style/InputBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="10" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 评论模式 ==================== -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/TxtSection"
                android:text="评论模式" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/seg_comment_copy"
                    style="@style/SegItemSelected"
                    android:text="复制评论" />

                <TextView
                    android:id="@+id/seg_comment_preset"
                    style="@style/SegItem"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_normal"
                    android:text="预设评论" />
            </LinearLayout>

            <TextView
                style="@style/TxtFieldLabel"
                android:layout_marginTop="14dp"
                android:text="复制评论说明" />

            <TextView
                android:id="@+id/tv_comment_mode_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_hint"
                android:paddingStart="12dp"
                android:paddingTop="11dp"
                android:paddingEnd="12dp"
                android:paddingBottom="11dp"
                android:text="启动后将自动复制直播间中的最新评论并发送"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
