<?xml version="1.0" encoding="utf-8"?>
<!--
  抖加加 adaptive icon 背景层：品牌红对角渐变 + 右上角柔和高光。
  与 tools/gen_launcher_icon.py 生成的位图 fallback 使用同一组颜色与几何，
  保证 API 26+ 和 API 24-25 两套图标看起来是同一个东西。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色：左上 #FF3D2F → 右下 #C0140B -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF3D2F" android:offset="0.0" />
                <item android:color="#C0140B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右上柔光，避免大面积纯色发死（约 16% 白） -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="84"
                android:centerY="22"
                android:gradientRadius="62">
                <item android:color="#29FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
