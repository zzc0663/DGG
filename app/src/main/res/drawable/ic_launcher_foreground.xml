<?xml version="1.0" encoding="utf-8"?>
<!--
  抖关关 adaptive icon 前景层：白色粗对勾（圆头圆角）。
  几何与 tools/gen_launcher_icon.py 完全一致，落在 66dp 安全区（21~87）内，
  桌面裁成圆形/方形都不会切到笔画。

  monochrome 也指向本文件：系统只取它的 alpha 当形状再染色，
  所以前景必须是纯形状、不要带渐变或半透明。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M29,54.6 L45.3,71.5 L79,32.8"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="12.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
