<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 保活引导：直接跳到「忽略电池优化」授权页 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 前台服务通知（API 33+ 为运行时权限，不申请则通知不可见） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务本体 + specialUse 类型（API 34+ 必须显式声明类型权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- OTA 下载用 dataSync 前台服务：这是「在后台传输数据」唯一对得上的类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 状态悬浮窗（特殊权限，走 Settings 授权，不是运行时权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- OTA 检查更新 / 下载安装包。这是本应用唯一的联网用途 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 8+ 安装 APK；侧载分发，不走商店 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Android 11+ 包可见性：不声明 <queries> 的话，即使抖音已安装，
      getLaunchIntentForPackage / getPackageInfo 也一律返回 null / 抛异常，
      于是 isInstalled() 恒为 false，「开始服务」会被直接拒绝成「未检测到抖音」。
      只声明抖音这一个包，不用 QUERY_ALL_PACKAGES（后者过商店审核会被追问）。
    -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DGG"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          日志页已移除（2026-10-28）：日志不再允许本地查看，点「日志」直接上报云端。
          排查靠 debug 包的调试通道（files/runtime.log + DUMP 等命令）。
        -->

        <!--
          无障碍服务。特点：
          - exported 必须为 true，否则系统设置页看不到它；
          - permission 必须是 BIND_ACCESSIBILITY_SERVICE，这是防止任意应用绑定本服务的唯一保障；
          - meta-data 指向配置，能力声明（读窗口内容 / 手势）全在那里。
        -->
        <service
            android:name=".service.DggAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          前台服务。specialUse 不是「免死金牌」，Play 审核会看子类型说明，
          这里的 reason 写清楚：自动化会话期间常驻状态通知。
        -->
        <service
            android:name=".service.ControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility_automation_session" />
        </service>

        <!-- 状态悬浮窗。与前台服务同进程，进程被前台服务钉住 -->
        <service
            android:name=".service.FloatWindowService"
            android:exported="false" />

        <!--
          更新包下载。dataSync：Android 14+ 起必须与声明的权限 FOREGROUND_SERVICE_DATA_SYNC 对应，
          否则 startForeground 直接抛 SecurityException。系统给的 6 小时上限远大于本场景。
        -->
        <service
            android:name=".service.OtaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 日志导出：把 cache/logs 下的 txt 以 content:// 分享出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
